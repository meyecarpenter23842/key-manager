# Public URLs used by desktop clients. Never place database credentials or
# signing private keys in VITE_* variables.
VITE_ADMIN_API_URL=http://127.0.0.1:3101
VITE_LICENSE_API_URL=http://127.0.0.1:3101

# Server-only values. Key Manager Desktop can pass these to its bundled Admin
# API sidecar from %APPDATA%\com.keymanager.desktop\admin-api.env, from the
# KEY_MANAGER_ADMIN_API_ENV_FILE override, or from the process environment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/key_manager_dev
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=3101
ADMIN_SESSION_TTL_HOURS=12
ADMIN_API_ALLOWED_ORIGINS=http://localhost:1420,http://tauri.localhost

# Raw license keys are stored only as AES-256-GCM ciphertext. For the installed
# Windows Key Manager, leave this unset: the Tauri host provisions a 32-byte
# master key and protects it with Windows DPAPI. Hosted/shared API deployments
# must provide one stable shared key (64 hex characters or base64 for 32 bytes).
LICENSE_KEY_ENCRYPTION_KEY=

# Public License API fixed-window rate limit per client IP.
LICENSE_API_RATE_LIMIT_MAX=120
LICENSE_API_RATE_LIMIT_WINDOW_SECONDS=60

# Offline license signing. Keep disabled until an Ed25519 server key is provisioned.
# Prefer OFFLINE_SIGNING_PRIVATE_KEY_FILE pointing to a secret mounted outside the repo.
OFFLINE_SIGNING_ENABLED=false
OFFLINE_SIGNING_KEY_ID=km-ed25519-2026-01
OFFLINE_SIGNING_PRIVATE_KEY_FILE=
# Inline PEM is supported for secret providers that expose env vars. Never use VITE_*.
# OFFLINE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
