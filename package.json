{
  "name": "key-manager",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:prepare-sidecar": "node scripts/build-admin-api-sidecar.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "server:start": "node server/src/index.mjs",
    "server:test:integration": "node server/tests/reset-integration-state.mjs && node server/tests/admin-auth.integration.mjs && node server/tests/applications-customers.integration.mjs && node server/tests/licenses.integration.mjs && node server/tests/devices.integration.mjs && node server/tests/public-license.integration.mjs && node server/tests/offline-license.integration.mjs",
    "admin:create-owner": "node server/scripts/create-owner.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "node scripts/database.mjs check",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:test": "node scripts/database.mjs test",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:check": "pnpm desktop:prepare-sidecar && cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:test": "pnpm desktop:prepare-sidecar && cargo test --manifest-path src-tauri/Cargo.toml",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
