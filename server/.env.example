# Server-only configuration. Never expose these values through VITE_* variables or package them with Tauri.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/key_manager_dev
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=3001
ADMIN_SESSION_TTL_HOURS=12
# Comma-separated origins allowed for browser/WebView CORS. localhost:1420 is
# the Tauri/Vite development origin; production must explicitly set its own origin(s).
ADMIN_API_ALLOWED_ORIGINS=http://localhost:1420

# Offline license signing. Prefer a secret-mounted file outside the repository.
OFFLINE_SIGNING_ENABLED=false
OFFLINE_SIGNING_KEY_ID=km-ed25519-2026-01
OFFLINE_SIGNING_PRIVATE_KEY_FILE=
# OFFLINE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
